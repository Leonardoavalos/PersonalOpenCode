# Copy this file to .env and fill it in:  cp env.example .env

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Password for the local `opencode serve` instance. Any long random string.
OPENCODE_PASSWORD=

# Comma separated Telegram user ids allowed to talk to the bot.
# Leave empty only while testing: empty means every user is accepted.
ALLOWED_USER_IDS=

# Local port for `opencode serve`.
OPENCODE_PORT=4096

# Directory the assistant works in. Empty means this project directory.
WORKSPACE=

# Agent id, taken from .opencode/agents/<name>.md
OPENCODE_AGENT=remote
